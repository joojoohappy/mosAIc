# Copy to .env and paste your key. .env is gitignored; never commit it.
# Console -> https://console.anthropic.com/settings/keys
# The anthropic SDK reads this exact name automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional reliability knobs (defaults shown). See docs/engineering-case-study/07-architecture-decisions.md.
# Hard deadline for one provider call; on overrun the request falls back to cached/mock.
# MOSAIC_PROVIDER_TIMEOUT_S=60
# Generations allowed to run at once; extra requests wait. Match the provider's rate limit.
# MOSAIC_MAX_CONCURRENT_GENERATIONS=8
