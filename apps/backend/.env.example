# Copy to .env and fill in. .env is gitignored; never commit it.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Image model ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey and set a spending cap there.
# Without a key the backend still runs: results fall back to cached or mock.
GEMINI_API_KEY=
# MOSAIC_IMAGE_MODEL=gemini-nano-banana-2.1
# MOSAIC_PROVIDER_TIMEOUT=60          # seconds, capped at 60

# --- Cost and abuse limits (conservative defaults, not final product limits)
# MOSAIC_RATE_PER_MINUTE=3            # generations per visitor per minute
# MOSAIC_DAILY_PER_CLIENT=10          # generations per visitor per UTC day
# MOSAIC_DAILY_GLOBAL=50              # paid model calls per UTC day, all visitors
# MOSAIC_MAX_CONCURRENT=2             # model calls running at once (per instance)

# --- Visitor identity for the limits ---------------------------------------
# Same random value on the website and here; lets the website vouch for the
# visitor IP (apps/web/proxy.ts). Generate with: openssl rand -hex 32
# MOSAIC_PROXY_SECRET=
# Only behind your own reverse proxy that overwrites X-Real-IP:
# MOSAIC_TRUST_X_REAL_IP=1

# --- Result storage --------------------------------------------------------
# Local dev and Docker keep results in storage/results/. On Vercel connect a
# Blob store (it sets BLOB_READ_WRITE_TOKEN); without one, live generation
# stays off there.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private                 # keep private: images are served via the API
# MOSAIC_RESULT_RETENTION_DAYS=30     # results older than this are no longer served
