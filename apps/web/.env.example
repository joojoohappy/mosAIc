# Server-only settings. Never put an AI key in NEXT_PUBLIC_* variables.

# The FastAPI backend origin. Read at build time (next.config.ts rewrites).
BACKEND_URL=http://127.0.0.1:8000

# Same value as the backend's MOSAIC_PROXY_SECRET, so per-visitor limits count
# real visitors (apps/web/proxy.ts). Generate with: openssl rand -hex 32
# MOSAIC_PROXY_SECRET=
# Only behind your own reverse proxy that overwrites X-Real-IP (Vercel is
# detected automatically):
# MOSAIC_TRUST_X_REAL_IP=1
