{
  "name": "mosaic",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mosaic/web dev",
    "build": "pnpm --filter @mosaic/web build",
    "start": "pnpm --filter @mosaic/web start",
    "typecheck": "pnpm --filter @mosaic/web typecheck",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "format": "prettier --write .",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:all": "bash scripts/test-all.sh",
    "lint": "prettier --check . && pnpm typecheck"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.56.1",
    "prettier": "3.8.1"
  }
}
