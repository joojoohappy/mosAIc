# This network stalls mid-download on large tarballs (observed: next.js timed
# out at 85%/41.7MB with pnpm's 60s default). Bump the timeout and retry
# budget instead of fighting the network.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=20000
# Confirmed by isolated curl tests: a solo download of the same 41.7MB
# tarball completes cleanly every time (HTTP/1.1 and HTTP/2 both), but
# pnpm's install always died at the same ~33-35MB mark across 5 attempts
# with network-concurrency=8. This network can't sustain many parallel
# streams -- serialize instead of fighting it with more retries.
network-concurrency=1
